# Copy to .env and fill in. Everything is optional in mock-data mode.

# Your Etsy shop name (scraper/my_shop.py)
MY_ETSY_SHOP_NAME=your_shop_name_here

# OpenAI — enables the AI weekly briefing, traffic insights and card clustering
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Analytics 4 — numeric property ID; OAuth client file goes in ga4-credentials-oauth.json
GA4_PROPERTY_ID=

# Etsy Open API v3 — once your app is approved
ETSY_API_KEY=
ETSY_SHARED_SECRET=
